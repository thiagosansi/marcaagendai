# Copie para .env e preencha. O .env é gitignorado — nunca commitar chaves.

# Chave da API da OpenAI (usada só por tools/generate_image.py)
OPENAI_API_KEY=

# Modelo de imagem — configurável, nunca hardcodado nos scripts.
# Padrão atual da conta: gpt-image-2 (renderiza texto em pt-BR com precisão).
# Outros disponíveis: gpt-image-1.5, gpt-image-1, ou qualquer modelo futuro.
OPENAI_IMAGE_MODEL=gpt-image-2

# Qualidade padrão das gerações: low | medium | high | auto
OPENAI_IMAGE_QUALITY=high
