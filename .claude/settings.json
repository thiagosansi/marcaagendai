{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(mkdir:*)",
      "WebFetch(domain:fonts.google.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sinalizar-matriz.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/statusline-agencia.sh\""
  }
}
